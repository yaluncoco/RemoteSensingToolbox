QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    color: #17202A;
}


QMainWindow {
    background: #F5F7FA;
}

QFrame#sidebar {
    background: #17202A;
    border: none;
}

QLabel#sidebarTitle {
    color: #FFFFFF;
    font-size: 14pt;
    font-weight: 700;
}

QLabel#sidebarSubtitle {
    color: #A7B2C1;
    font-size: 8.5pt;
}

QToolButton#updateButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0;
}

QToolButton#updateButton:hover,
QToolButton#updateButton:focus {
    background: #223044;
    border-color: #3A4B63;
}

QToolButton#updateButton:pressed {
    background: #304058;
}

QDialog#updateDialog {
    background: #F5F7FA;
}

QLabel#updateHeading {
    color: #111827;
    font-size: 14pt;
    font-weight: 700;
}

QTextBrowser#releaseNotes {
    background: #FFFFFF;
    border: 1px solid #D8E0EA;
    border-radius: 8px;
    padding: 10px;
}

QPushButton#secondaryButton {
    color: #42526A;
    background: #FFFFFF;
    border-color: #CBD5E1;
}

QPushButton#secondaryButton:hover {
    background: #EDF2F7;
}

QPushButton#secondaryButton:disabled {
    color: #94A3B8;
    background: #EEF2F7;
}

QPushButton#categoryButton {
    color: #DCE6F1;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 10px;
    text-align: left;
    font-weight: 600;
}

QPushButton#categoryButton:hover {
    background: #223044;
    border-color: #3A4B63;
}

QPushButton#categoryButton:checked,
QPushButton#categoryButton[active="true"] {
    color: #FFFFFF;
    background: #2563A8;
    border-color: #2E7BCB;
}

QWidget#content,
QWidget#toolsView {
    background: #F5F7FA;
}

QLabel#pageTitle {
    color: #111827;
    font-size: 15pt;
    font-weight: 700;
}

QLabel#summaryLabel {
    color: #64748B;
    font-size: 9pt;
}

QLineEdit#searchEdit {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 20px;
    color: #111827;
}

QLineEdit#searchEdit:focus {
    border-color: #2563A8;
}

QScrollArea#toolScroll {
    background: transparent;
    border: none;
}

QFrame#toolCard {
    background: #FFFFFF;
    border: 1px solid #D8E0EA;
    border-radius: 8px;
}

QFrame#toolCard:hover {
    border-color: #2E7BCB;
    background: #FBFDFF;
}

QFrame#extractorToolbar,
QFrame#extractorPanel {
    background: #FFFFFF;
    border: 1px solid #D8E0EA;
    border-radius: 8px;
}

QLabel#sectionTitle {
    color: #0F172A;
    font-size: 11pt;
    font-weight: 700;
}

QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #D8E0EA;
    border-radius: 6px;
    gridline-color: #E2E8F0;
}

QHeaderView::section {
    background: #EEF2F7;
    color: #334155;
    border: none;
    border-right: 1px solid #D8E0EA;
    border-bottom: 1px solid #D8E0EA;
    padding: 6px 8px;
    font-weight: 700;
}

QLabel#toolIcon {
    background: #E8F1FB;
    border: none;
    border-radius: 6px;
}

QLabel#toolTitle {
    color: #0F172A;
    font-size: 11pt;
    font-weight: 700;
}

QLabel#toolCategory {
    color: #64748B;
    font-size: 8.5pt;
}

QLabel#toolSummary {
    color: #475569;
    font-size: 9.5pt;
}

QPushButton#openToolButton {
    min-width: 36px;
    min-height: 18px;
    padding: 4px 10px;
    border-radius: 5px;
    font-size: 9pt;
}

QPushButton#primaryButton,
QPushButton {
    background: #2563A8;
    color: #FFFFFF;
    border: 1px solid #2563A8;
    border-radius: 7px;
    padding: 8px 14px;
    font-weight: 600;
    min-width: 74px;
}

QPushButton#primaryButton:hover,
QPushButton:hover {
    background: #1D4F86;
    border-color: #1D4F86;
}

QPushButton#primaryButton:pressed,
QPushButton:pressed {
    background: #173F6B;
    border-color: #173F6B;
}

QPushButton:disabled {
    background: #CBD5E1;
    border-color: #CBD5E1;
    color: #64748B;
}

QGroupBox {
    background: #FFFFFF;
    border: 1px solid #D8E0EA;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #1F2937;
    background: #FFFFFF;
}

QLineEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #2E7BCB;
}

QLineEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #2563A8;
}

QProgressBar {
    background: #E5EAF0;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    min-height: 18px;
    text-align: center;
}

QProgressBar::chunk {
    background: #2F855A;
    border-radius: 5px;
}

QTabWidget::pane {
    border: 1px solid #D8E0EA;
    border-radius: 8px;
    background: #FFFFFF;
}

QTabBar::tab {
    background: #E9EEF5;
    color: #334155;
    padding: 8px 14px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    margin-right: 3px;
}

QTabBar::tab:selected {
    background: #2563A8;
    color: #FFFFFF;
}

QLabel#emptyLabel {
    color: #64748B;
    background: #FFFFFF;
    border: 1px dashed #CBD5E1;
    border-radius: 8px;
    padding: 40px;
}

QStatusBar {
    background: #EEF2F7;
    color: #42526A;
}

QWidget#metricsWindow { background: #f4f7f8; }
QWidget#inspectorBody { background: #ffffff; border-radius: 12px; }
QLabel#qualityNote { background: #f0f5ed; color: #556549; border-radius: 8px; padding: 10px; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 9px; margin: 2px; }
QScrollBar::handle:vertical { background: #c2cdd5; border-radius: 3px; min-height: 36px; }
QScrollBar::handle:vertical:hover { background: #8dabb5; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 2px; }
QScrollBar::handle:horizontal { background: #c2cdd5; border-radius: 3px; min-width: 36px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
QSplitter::handle { background: #e8edef; border-radius: 2px; }
QSplitter::handle:hover { background: #a5c4c5; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: #e9eff2; color: #647680; padding: 10px 24px; margin-right: 6px; border-radius: 8px; }
QTabBar::tab:selected { background: #dcece9; color: #17665e; font-weight: 600; }
QGroupBox { border: 1px solid #e2e9ed; border-radius: 10px; margin-top: 16px; padding: 16px 10px 10px; background: #ffffff; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #42616b; font-weight: 600; }
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox { background: #ffffff; border: 1px solid #d8e2e8; border-radius: 8px; padding: 7px 10px; selection-background-color: #c3e1df; selection-color: #163b38; }
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus { border-color: #6fa99f; background: #fbfdfd; }
QToolButton#stepButton { background: #edf3f5; color: #3e626b; border: none; border-radius: 6px; font-size: 13pt; }
QToolButton#stepButton:hover { background: #d7e8e7; }
QSlider::groove:horizontal { background: #dde7eb; height: 5px; border-radius: 2px; }
QSlider::handle:horizontal { background: #4a968c; width: 14px; margin: -5px 0; border-radius: 7px; }
QSlider::sub-page:horizontal { background: #a3c9c3; border-radius: 2px; }
QProgressBar { background: #e7eef0; border: none; border-radius: 4px; max-height: 8px; color: transparent; }
QProgressBar::chunk { background: #65a59a; border-radius: 4px; }

QWidget#metricsWindow QPushButton { background: #286f67; border-color: #286f67; border-radius: 8px; }
QWidget#metricsWindow QPushButton:hover { background: #357f76; }
QWidget#metricsWindow QPushButton#secondaryButton { background: #ffffff; color: #49636a; border-color: #d5e0e5; }
QWidget#metricsWindow QPushButton:disabled { background: #e2e9eb; border-color: #e2e9eb; color: #8b9ca5; }
QProgressBar { min-height: 6px; max-height: 6px; }
QTableWidget::item:selected { background: #dbece8; color: #245b54; }
QFrame#metricTile { background: #edf5f2; border: none; border-radius: 8px; }
QLabel#metricValue { color: #245f57; font-size: 15pt; font-weight: 600; }
